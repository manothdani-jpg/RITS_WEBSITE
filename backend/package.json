{
  "name": "rits-backend",
  "version": "1.0.0",
  "description": "Rhode Island Tamil Sangam — member database API",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "node db/seed.js",
    "db:backup": "bash db/backup.sh",
    "db:restore": "bash db/restore.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.12.0",
    "square": "^45.1.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
