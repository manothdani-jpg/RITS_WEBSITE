# Copy to .env and fill in real values. Never commit .env.

# postgres://user:password@host:port/database
DATABASE_URL=postgres://manothrajagopal@localhost:5432/rits_dev

# Long random string used to sign admin JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Long random string used to encrypt secrets stored in the database (currently
# just the SMTP password, set from the admin dashboard — see below). Generate
# the same way as JWT_SECRET, but keep it a separate value. Losing or changing
# this key makes any already-stored encrypted values undecryptable — you'd
# need to re-enter the SMTP password from the admin dashboard after rotating it.
ENCRYPTION_KEY=change-me-to-a-different-long-random-string

# How long an admin login session lasts
JWT_EXPIRES_IN=12h

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API
# (your static site's local dev URL and eventual production domain)
CORS_ORIGINS=http://localhost:8420,http://127.0.0.1:8420

# Base URL of the member portal — used to build password reset links.
# No trailing slash.
PORTAL_URL=http://localhost:8420/portal

# --- Email (for "forgot password" and Communications) ---
# SMTP is configured from the admin dashboard now (Admin Logins tab,
# superadmin-only), not here — see the "Mail server setup" section of
# README.md. Leaving it unconfigured is fine for local dev: reset links
# and communications are printed to the server console instead of sent.

# --- Square (for online dues payment) ---
# From the Square Developer Dashboard (https://developer.squareup.com/apps) —
# Sandbox credentials are free and don't require a verified business account,
# good for testing the whole flow before your real Square account is ready.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# From the webhook subscription you create in that same dashboard, pointed
# at SQUARE_WEBHOOK_URL below. SQUARE_WEBHOOK_URL must match EXACTLY what
# you entered there (Square verifies signatures against the exact URL).
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=http://localhost:4000/api/payments/webhook
